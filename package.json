{
  "name": "little-alexandria",
  "version": "0.1.0",
  "private": true,
  "description": "A warm, tactile personal bookshelf. Every great reader deserves a great library.",
  "type": "module",
  "license": "MIT",
  "author": "Karthik Subramanian",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c yellow,green \"vite\" \"pnpm dev:api\"",
    "dev:api": "mkdir -p dist && pnpm db:migrate:local && wrangler pages dev --port 8788 --live-reload=false",
    "build": "tsc -b && vite build",
    "preview": "pnpm build && pnpm db:migrate:local && wrangler pages dev --port 8788",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "deploy": "pnpm build && pnpm db:migrate:remote && wrangler pages deploy",
    "db:migrate:local": "wrangler d1 migrations apply little-alexandria --local",
    "db:migrate:remote": "wrangler d1 migrations apply little-alexandria --remote"
  },
  "dependencies": {
    "@dnd-kit/helpers": "^0.5.3",
    "@dnd-kit/react": "^0.5.3",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "arctic": "^3.7.0",
    "clsx": "^2.1.1",
    "fast-average-color": "^9.6.0",
    "fractional-indexing": "^4.0.0",
    "hono": "^4.13.18",
    "motion": "^14.12.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "8.3.8",
    "vitest": "4.1.12",
    "wrangler": "4.161.0"
  }
}
